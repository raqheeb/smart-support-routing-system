# Smart Support Routing System Configuration
# Copy this file to .env and adjust variables as needed

# Claude / Anthropic API (Optional for LLM reasoning fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Confidence Thresholds (aligned with README pipeline)
# confidence >= AUTO_ROUTE_THRESHOLD (0.80) -> Auto Route (Green)
# confidence >= LLM_ASSIST_THRESHOLD (0.65) -> Optional AI Assist (Yellow)
# confidence < LLM_ASSIST_THRESHOLD         -> Human Handoff (Red)
AUTO_ROUTE_THRESHOLD=0.80
LLM_ASSIST_THRESHOLD=0.65
AUTO_ROUTE_MIN_MARGIN=0.10

# Anthropic calls are disabled by default; enabling them can incur API charges.
ANTHROPIC_ENABLED=false

# Database
DATABASE_URL=sqlite:///./database/logs.db

# Server settings
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=7860
LOG_LEVEL=INFO
